generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TUTOR
  STUDENT
}

enum QuestionType {
  MCQ
  MSQ
  NUMERIC
  PASSAGE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum TestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EVALUATED
}

enum NotificationType {
  TEST_ASSIGNED
  TEST_DEADLINE
  TEST_START_REMINDER
  TEST_RESUME_REMINDER
  TEST_SUBMITTED
  REPORT_PUBLISHED
  TUTOR_ANNOUNCEMENT
  SYSTEM_ANNOUNCEMENT
}

model User {
  id          String   @id @default(uuid())
  name        String?
  email       String   @unique
  role        Role     @default(STUDENT)
  permissions Json?    // To handle dynamic RBAC like specific permissions
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Soft delete: set when an admin removes this user. Excluded from normal
  // listings and login, but the row (and everything cascading from it —
  // attempts, assignments, tutor links) stays intact until a separate,
  // explicit permanent-delete action removes it for good.
  deletedAt   DateTime?

  // Relations
  testsCreated Test[]
  attempts     TestAttempt[]
  testAssignments TestAssignment[]
  testPackages    TestPackage[]

  // Tutor assignments: a user can be a tutor for many, or a student under many tutors
  students      TutorAssignment[] @relation("TutorToStudent")
  tutors        TutorAssignment[] @relation("StudentToTutor")
  notifications Notification[]

  // PDF documents an admin uploaded / shared with this user (Documents page)
  documentsUploaded   Document[]           @relation("DocumentUploader")
  documentAssignments DocumentAssignment[]
}

model TutorAssignment {
  id        String   @id @default(uuid())
  tutorId   String
  studentId String
  createdAt DateTime @default(now())

  tutor   User @relation("TutorToStudent", fields: [tutorId], references: [id], onDelete: Cascade)
  student User @relation("StudentToTutor", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tutorId, studentId])

  @@index([studentId])
}

model Topic {
  id        String   @id @default(uuid())
  name      String
  parentId  String?
  createdAt DateTime @default(now())

  parent    Topic?  @relation("SubTopics", fields: [parentId], references: [id])
  subTopics Topic[] @relation("SubTopics")
  questions Question[]
}

model Question {
  id               String       @id @default(uuid())
  type             QuestionType
  content          Json         // Rich text or math
  options          Json?        // For MCQ/MSQ
  correctAnswer    Json         // The correct answer(s)
  difficultyLevel  Difficulty
  topicId          String?
  referenceId      String?
  subject          String?
  parentQuestionId String?      // For linked questions under a passage
  createdAt        DateTime     @default(now())

  topic            Topic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)
  parentQuestion   Question?    @relation("ParentChild", fields: [parentQuestionId], references: [id], onDelete: Cascade)
  childQuestions   Question[]   @relation("ParentChild")
  testQuestions    TestQuestion[]
  attemptAnswers   AttemptAnswer[]

  @@index([parentQuestionId])
  @@index([topicId])
}

model Test {
  id          String     @id @default(uuid())
  title       String
  description String?
  createdById String
  status      TestStatus @default(DRAFT)
  category    String?
  subCategory String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  createdBy   User          @relation(fields: [createdById], references: [id])
  sections    TestSection[]
  questions   TestQuestion[]
  attempts    TestAttempt[]
  assignments TestAssignment[]
  packageItems TestPackageItem[]
}

// A named bundle of tests that can be assigned to students all at once.
model TestPackage {
  id          String   @id @default(uuid())
  title       String
  description String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User              @relation(fields: [createdById], references: [id])
  items       TestPackageItem[]
}

model TestPackageItem {
  id         String @id @default(uuid())
  packageId  String
  testId     String
  orderIndex Int    @default(0)

  package    TestPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  test       Test        @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([packageId, testId])

  @@index([testId])
}

model TestSection {
  id              String   @id @default(uuid())
  testId          String
  name            String
  durationMinutes Int
  orderIndex      Int
  config          Json?

  test            Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  questions       TestQuestion[]
  sectionAttempts SectionAttempt[]

  @@index([testId])
}

model TestQuestion {
  id            String @id @default(uuid())
  testId        String
  sectionId     String
  questionId    String
  marksPositive Float  @default(1.0)
  marksNegative Float  @default(0.0)
  orderIndex    Int

  test          Test        @relation(fields: [testId], references: [id], onDelete: Cascade)
  section       TestSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  question      Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([testId, questionId])

  @@index([sectionId])
  @@index([questionId])
}

model TestAttempt {
  id          String        @id @default(uuid())
  testId      String
  studentId   String
  status      AttemptStatus @default(IN_PROGRESS)
  totalScore  Float?
  startedAt   DateTime      @default(now())
  completedAt DateTime?

  test            Test             @relation(fields: [testId], references: [id], onDelete: Cascade)
  student         User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sectionAttempts SectionAttempt[]
  answers         AttemptAnswer[]
  cheatingLogs    CheatingLog[]
  events          AttemptEvent[]

  @@index([studentId, startedAt])
  @@index([testId])
  @@index([status, completedAt])
}

model TestAssignment {
  id              String   @id @default(uuid())
  testId           String
  studentId        String
  dueAt            DateTime?
  availableFrom    DateTime?
  availableUntil   DateTime?
  maxAttempts      Int      @default(1)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  test             Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  student          User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([testId])
}

model SectionAttempt {
  id          String    @id @default(uuid())
  attemptId   String
  sectionId   String
  startedAt   DateTime  @default(now())
  completedAt DateTime? // Server-authoritative end time

  attempt TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  section TestSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, sectionId])

  @@index([sectionId])
}

model AttemptAnswer {
  id                 String   @id @default(uuid())
  attemptId          String
  questionId         String
  answerGiven        Json?
  timeSpentSeconds   Int      @default(0)
  isFlagged          Boolean  @default(false)
  doubtStatus        String?
  updatedAt          DateTime @updatedAt

  attempt  TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])

  @@index([questionId])
}

model CheatingLog {
  id        String   @id @default(uuid())
  attemptId String
  eventType String
  metadata  Json?
  createdAt DateTime @default(now())

  attempt TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, eventType])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  data      Json?
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Append-only log of what happened in the test player (question shown/left,
// answer chosen/cleared, flag, tab hidden, idle, module end…). Never updated:
// visit-level time analytics are rebuilt from it (src/lib/timeAnalytics.ts),
// so a bug in the reconstruction can be fixed and re-run on old attempts.
model AttemptEvent {
  id         BigInt   @id @default(autoincrement())
  attemptId  String
  seq        Int      // client counter, defines order
  eventType  String   @db.VarChar(16)
  questionId String?
  tMs        Int      // ms since the attempt started (monotonic on the client)
  choice     Json?    // ANSWER only — the raw choice, never its correctness
  clientWall DateTime? // audit only
  receivedAt DateTime @default(now())

  attempt TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, seq]) // makes retried batches idempotent
}

// PDF study material an admin uploads and shares with chosen students/tutors.
// The file lives in the private Supabase Storage bucket "documents"
// (storage = 'supabase', storagePath set) or, when storage isn't configured,
// in the row itself (storage = 'db', data set). It is only ever served through
// GET /api/documents/[id]/file, which checks the caller is an admin or assigned.
model Document {
  id           String   @id @default(uuid())
  title        String
  description  String?
  fileName     String
  sizeBytes    Int
  storage      String   @default("supabase") @db.VarChar(16)
  storagePath  String?
  data         Bytes?
  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploadedBy  User?                @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  assignments DocumentAssignment[]
}

model DocumentAssignment {
  id           String   @id @default(uuid())
  documentId   String
  userId       String
  assignedById String?
  createdAt    DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
  @@index([userId])
}
