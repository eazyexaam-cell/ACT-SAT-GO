{
  "version": 2,
  "framework": null,
  "buildCommand": "cd nextgen-react && npm install && npm run build && cd .. && mkdir -p public && cp -r nextgen-react/dist/* public/",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/contact-us", "destination": "/consultation", "statusCode": 301 },
    { "source": "/contact", "destination": "/consultation", "statusCode": 301 },
    { "source": "/enquiry", "destination": "/consultation", "statusCode": 301 },
    { "source": "/about", "destination": "/about-us", "statusCode": 301 },
    { "source": "/take-free-test", "destination": "/free-test", "statusCode": 301 },
    { "source": "/the-act-exam-a-comprehensive-guide", "destination": "/act", "statusCode": 301 },
    { "source": "/blog", "destination": "/resources", "statusCode": 301 },
    { "source": "/blogs", "destination": "/resources", "statusCode": 301 },
    { "source": "/privacy", "destination": "/privacy-policy", "statusCode": 301 },
    { "source": "/terms-and-conditions", "destination": "/terms", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/admin/:path*", "destination": "/api/index.js" },
    { "source": "/admin", "destination": "/api/index.js" },
    { "source": "/free-test/:testId", "destination": "/free-test.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
